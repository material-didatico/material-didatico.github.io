  def fatorial( n ):

    f = 1

    for k in range( 1, n+1 ):
      f = f * k

    return f


-- frame:20: -------------------------------------------------------------------

  def fatorial_2( n ):

    f = 1

    while n > 1:
      f = f * n
      n = n - 1

    return f


