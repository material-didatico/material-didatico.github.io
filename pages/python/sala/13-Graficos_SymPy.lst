-- frame:3: -------------------------------------------------------------------

import sympy as sp

from sympy.plotting import ( plot,
                             plot_parametric,
                             plot3d )

sp.init_printing()

x, y, t = sp.symbols('x y t')


-- frame:5: -------------------------------------------------------------------

f = x**3 - 3*x + 1

plot(f, (x, -3, 3))


-- frame:6: -------------------------------------------------------------------

g = 2*x + 1

plot(f, g, (x, -4, 4), legend=True)


-- frame:7: -------------------------------------------------------------------

pl = plot(f, g, (x, -4, 4), legend=True, show=False)

pl.ylim = (-5, 5)

pl.show()


-- frame:8: -------------------------------------------------------------------

plot_parametric(t*sp.cos(t), t*sp.sin(t), (t, 0, 2*sp.pi))


-- frame:10: -------------------------------------------------------------------

z = x**2 + y**2

plot3d(z, (x, -3, 3), (y, -3, 3))


-- frame:11: -------------------------------------------------------------------

z = sp.sin(x)*sp.cos(y)

plot3d(z, (x, -sp.pi, sp.pi), (y, -sp.pi, sp.pi))


-- frame:12: -------------------------------------------------------------------

x_t = t * sp.cos(t)

y_t = t * sp.sin(t)

z_t = -sp.sqrt(t)

plot3d_parametric_line(x_t, y_t, z_t, (t, 0, 12*sp.pi))


-- frame:15: -------------------------------------------------------------------

x_t = 2*sp.cos(t)*(1 - sp.cos(t))
y_t = 2*sp.sin(t)*(1 - sp.cos(t))

plot_parametric(x_t, y_t, (t, 0, 2*sp.pi))


-- frame:17: -------------------------------------------------------------------

x_t = sp.cos(t)/(1 + sp.sin(t)**2)
y_t = (sp.sin(t)*sp.cos(t))/(1 + sp.sin(t)**2)

plot_parametric( x_t, y_t, (t, 0, 2*sp.pi) )


