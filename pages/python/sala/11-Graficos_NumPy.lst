def triangulo(a, b):

    x = [ 0, a, 0, 0]

    y = [ 0, 0, b, 0]

    plt.plot(x, y)


-- frame:17: -------------------------------------------------------------------

def triangulo(a, b):

    x = [ 0, a, 0, 0]
    y = [ 0, 0, b, 0]

    plt.plot(x, y)
    plt.gca().set_aspect('equal', adjustable='box')
    plt.axis('off')
    plt.draw()


-- frame:23: -------------------------------------------------------------------

def desenhar_poligono( n, r ):

  t = np.linspace( 0, 2*np.pi, n+1 );
  x = r * np.cos( t )
  y = r * np.sin( t )

  plt.plot( x, y )
  plt.gca().set_aspect('equal', adjustable='box')
  plt.axis('off')
  plt.draw()


-- frame:24: -------------------------------------------------------------------

for k in range(4,20):
  desenhar_poligono( k, k )


